# ─────────────── TalCloud Panel — configuration ───────────────
# Copiez ce fichier en « .env » puis renseignez les valeurs. Ne le versionnez jamais.

# Nom de domaine du panel (utilisé par Caddy pour obtenir le certificat HTTPS).
DOMAIN=panel.exemple.com
# URL publique exacte du panel, en https://, sans slash final.
PUBLIC_URL=https://panel.exemple.com

# Clé maîtresse de chiffrement AES-256 des secrets en base. Générer avec : openssl rand -hex 32
# ATTENTION : si cette clé est perdue, les clés API et secrets 2FA enregistrés sont irrécupérables.
MASTER_KEY=
# Secret des jetons de session et des codes. Générer avec : openssl rand -base64 48
SESSION_SECRET=

# Proxy inverse de confiance : seule adresse dont les en-têtes X-Forwarded-* (IP du client, https) sont crus.
# Avec le docker-compose fourni : l'IP fixe de Caddy, 172.30.0.2. Exposé en direct : false.
# Ne mettez jamais « true », « uniquelocal » ni une large plage : tout pair concerné pourrait usurper son IP
# et contourner la liste blanche et les limites anti-force brute.
TRUST_PROXY=172.30.0.2

# ── Sessions ──
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
# Durée de validité d'une re-confirmation 2FA pour les actions critiques.
STEP_UP_MINUTES=5

# ── Liste blanche d'IP (optionnelle) ── IP ou CIDR séparés par des virgules. Vide = désactivée.
IP_ALLOWLIST=

# ── SMTP du panel (obligatoire) ── codes de connexion et alertes de sécurité.
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS implicite), false pour 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalCloud Panel <panel@exemple.com>"

# ── Alertes de sécurité sur Discord (optionnel) ──
SECURITY_DISCORD_WEBHOOK_URL=

# ── Hook WHMCS (notifications de commandes) ──
# Secret partagé avec whmcs-hook/talcloud_notify.php. Générer avec : openssl rand -hex 32
WHMCS_HOOK_SECRET=
# IP du serveur WHMCS autorisées à appeler le webhook (optionnel mais recommandé).
WHMCS_HOOK_IPS=

# ── Géolocalisation des connexions (optionnel) ──
# Chemin d'une base MaxMind GeoLite2-Country.mmdb montée dans le conteneur.
GEOIP_DB_PATH=
# true uniquement si le panel est derrière Cloudflare (en-tête CF-IPCountry).
TRUST_CF_COUNTRY_HEADER=false

# Fuseau horaire du panel : à aligner sur celui de WHMCS pour que les statistiques mensuelles tombent juste.
TZ=Europe/Paris

LOG_LEVEL=info
